{
  "name": "The Toeic Lab — React + Django",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "The Toeic Lab", "onAutoForward": "openBrowser", "visibility": "private" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": { "settings": { "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python" } }
  }
}
