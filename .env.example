# Chỉ là mẫu; Django đọc biến môi trường đã export, không tự nạp file .env.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: đặt DJANGO_SECRET_KEY ngẫu nhiên qua biến môi trường an toàn.
# POSTGRES_DB=toeiclab
# POSTGRES_USER=toeiclab
# POSTGRES_PASSWORD= (nhập riêng, không commit)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER= (nhập riêng)
# EMAIL_HOST_PASSWORD= (nhập riêng)
# DEFAULT_FROM_EMAIL=noreply@example.com
